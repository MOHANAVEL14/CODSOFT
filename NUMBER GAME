import java.util.Random;
import java.util.Scanner;

public class NumberGame {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Random random = new Random();

        final int LOWER_BOUND = 1;
        final int UPPER_BOUND = 100;
        final int MAX_ATTEMPTS = 7;

        int roundsWon = 0;
        int totalScore = 0;
        char playAgain;

        do {
            int number = random.nextInt(UPPER_BOUND) + LOWER_BOUND;
            int attempts = 0;
            boolean guessedCorrectly = false;

            System.out.println("\nGuess the number between 1 and 100");
            System.out.println("You have " + MAX_ATTEMPTS + " attempts.");

            while (attempts < MAX_ATTEMPTS) {
                System.out.print("Enter your guess: ");
                int guess = sc.nextInt();
                attempts++;

                if (guess == number) {
                    System.out.println("Correct! You guessed it in " + attempts + " attempts.");
                    guessedCorrectly = true;
                    roundsWon++;

                    // Score calculation
                    int score = (MAX_ATTEMPTS - attempts + 1) * 10;
                    totalScore += score;
                    System.out.println("Score this round: " + score);
                    break;
                } else if (guess < number) {
                    System.out.println("Too Low!");
                } else {
                    System.out.println("Too High!");
                }
            }

            if (!guessedCorrectly) {
                System.out.println("ou've used all attempts. The number was: " + number);
            }

            System.out.print("\nDo you want to play again? (y/n): ");
            playAgain = sc.next().toLowerCase().charAt(0);

        } while (playAgain == 'y');

        System.out.println("\n--- Game Summary ---");
        System.out.println("Rounds Won : " + roundsWon);
        System.out.println("Total Score: " + totalScore);
        System.out.println("Thanks for playing!");

        sc.close();
    }
}
